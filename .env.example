DATABASE_URL="postgresql://brew:brew@localhost:5432/beer_journal?schema=public"
# Optional: separate URL for migrations (Supabase: session pooler, port 5432)
# DIRECT_URL=
# Currency symbol for costs (default ฿)
# CURRENCY=฿
# Optional: set both to require HTTP basic auth (recommended before deploying anywhere public)
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
